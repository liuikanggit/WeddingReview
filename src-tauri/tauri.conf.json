{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾光笺",
  "mainBinaryName": "wedding-review",
  "version": "0.1.0",
  "identifier": "com.liukang.weddingreview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾光笺",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Photography",
    "shortDescription": "婚纱照修图批注",
    "longDescription": "导入相册文件夹，在照片上圈注要修的地方，导出一份图文一体的 PDF 交给修图师。",
    "copyright": "© 2026 liukang",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
